{
  "name": "lingxi-browser-bridge",
  "version": "0.6.6",
  "description": "MCP Server that bridges Lingxi AI assistant with Chrome Extension for browser automation",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "pm-shawn",
  "repository": {
    "type": "git",
    "url": "https://github.com/PM-Shawn/Lingxi-Cowork"
  },
  "keywords": ["mcp", "browser", "automation", "chrome-extension", "lingxi"],
  "bin": {
    "lingxi-browser-bridge": "dist/index.js"
  },
  "files": [
